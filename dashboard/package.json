{
  "name": "signal-engine-dashboard",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode public --port 5173",
    "dev:admin": "vite --mode admin --port 5174",
    "build": "npm run check && npm run build:public && npm run build:admin",
    "build:public": "vite build --mode public",
    "build:admin": "vite build --mode admin",
    "check": "tsc --noEmit",
    "preview:public": "vite preview --mode public --port 4173",
    "preview:admin": "vite preview --mode admin --port 4174",
    "test": "playwright test && node --test tests/proxy.test.mjs",
    "test:proxy": "node --test tests/proxy.test.mjs"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
