# No secrets belong in VITE_* values: they are embedded into public JavaScript.
# For local dev, leave blank and use Vite's localhost API proxy.
VITE_API_URL=
VITE_WS_URL=
# Production Cloudflare Pages build example (set via Pages Settings -> Variables):
# VITE_API_URL=https://signal-engine-v5.vishalkool.top
# VITE_WS_URL=wss://signal-engine-v5.vishalkool.top
# VITE_DEV_API_TARGET=http://127.0.0.1:8000
