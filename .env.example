# Copy to .env on the server. Never commit the completed .env file.
# Generate independent secrets with: openssl rand -hex 48
ENV=production
PORT=8000

# Choose public only, private admin only, or both.
PUBLIC_APP_ENABLED=true
ADMIN_APP_ENABLED=true
# Use distinct HTTPS origins when both are enabled. Replace these with your domains.
PUBLIC_APP_ORIGIN=https://public.example.com
ADMIN_APP_ORIGIN=https://admin.example.com

# Required only when ADMIN_APP_ENABLED=true.
ADMIN_EMAILS=owner@example.com
ADMIN_SESSION_HOURS=12
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google OAuth callback: https://<your-admin-host>/auth/callback/google

# Required in production for a trusted frontend reverse proxy / Pages Function.
# The proxy must set this as the X-Origin-Verify header; never expose it to browsers.
ORIGIN_PROXY_SECRET=

# Backend services and persistent data
REDIS_URL=redis://redis:6379/0
SIGNAL_ENGINE_DB_PATH=database/signals.db
# Engine stays disabled until the operator verifies data, credentials, and backups.
ENGINE_ENABLED=false
TRADING_MODE=paper

# Optional Cloudflare Tunnel overlay. These values are only needed if you choose it.
TUNNEL_TOKEN=
TUNNEL_PROTOCOL=http2
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.2
MODE_SWITCH_RESTART=false

# Binance paper/demo account. Required for paper execution and safe mode preflight.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET=
BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com
# Live trading is opt-in. Leave these empty unless you intentionally enable it.
BINANCE_API_KEY=
BINANCE_SECRET=
SIGNAL_ENGINE_ALLOW_LIVE_TRADING=
TOTP_SECRET=

# Telegram incoming commands use a webhook.
TELEGRAM_TRANSPORT=webhook
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Numeric Telegram sender IDs, comma-separated. Set for private and group chats.
TELEGRAM_ALLOWED_USER_IDS=
WEBHOOK_SECRET=
# Optional explicit externally reachable endpoint; defaults to ADMIN_APP_ORIGIN/webhook/telegram.
# For a public-only deployment, set this to the HTTPS route you expose to Telegram.
TELEGRAM_WEBHOOK_URL=
# Optional free-text bot assistant; the admin research assistant is separate.
ENABLE_TELEGRAM_ASSISTANT=false

# Optional AI research assistant and local RAG indexing. Groq receives retrieved context.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional market-data integrations
FINNHUB_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_API_KEY=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Optional LangSmith tracing. Leave off unless you want telemetry sent to LangSmith.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=signal-engine

# Strategy and research defaults; these do not certify performance.
CAPITAL=1000
SYSTEM_VERSION=3.4.0
ADAPTATION_FROZEN=false
