# Copy to root .env on a disposable local checkout, or set variables via an environment manager. Never commit secrets.
ENV=development
TRADING_MODE=paper
REDIS_URL=redis://localhost:6379/0
PORT=8000
DOMAIN=
SYSTEM_VERSION=2.0.0
# Paper-account sizing context only. This does not represent an exchange balance.
CAPITAL=1000
# Generated secure random material, unique per environment:
JWT_SECRET=
OAUTH_JWT_SECRET=
SIGNAL_ENGINE_SETUP_TOKEN=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD_HASH=
TOTP_SECRET=
# Broker credentials NOT required for offline unit tests; never commit real values.
BINANCE_API_KEY=
BINANCE_SECRET=
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET=
BINANCE_DEMO_BASE_URL=https://testnet.binancefuture.com
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional administrator allowlist; comma-separated verified emails.
ADMIN_EMAILS=
FRONTEND_URL=http://localhost:5173
SIGNAL_ENGINE_DATABASE_PATH=database/signals.db
# Account-security email ONLY; no trading notifications.
RESEND_API_KEY=
SECURITY_EMAIL_FROM=
SECURITY_EMAIL_ENABLED=false
# Opt-in after local/browser session-origin tests; default keeps existing AWS clients working.
STRICT_SESSION_ORIGIN_CHECK=false
# Password/OAuth session token lifetime in hours.
OAUTH_JWT_EXPIRY_HOURS=168
# Existing Telegram trading notifications
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated Telegram sender user IDs allowed to run mutating bot commands.
TELEGRAM_ADMIN_USER_IDS=
WEBHOOK_SECRET=

# Opt-in: public email account routes remain unavailable until integration testing.
EMAIL_ACCOUNTS_ENABLED=false
# Optional data/assistant integrations. Keep unset when unused.
FINNHUB_KEY=
GROQ_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=signal-engine-v5
LANGCHAIN_TRACING_V2=false
# Optional content publishing integration. Keep disabled unless reviewed.
CONTENT_ENABLED=false
CONTENT_AUTO_APPROVE=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
# Internal strategy adaptation control.
ADAPTATION_FROZEN=false
