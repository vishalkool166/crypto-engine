# Copy to .env on the server. Never commit the completed .env file.
# Generate unique secrets with: openssl rand -hex 32
ENV=production
PORT=8000

# Initial mode only; authenticated mode changes are persisted in database/runtime_state.json.
TRADING_MODE=paper
# Start disabled. Enable after credentials, database, and backups are verified.
ENGINE_ENABLED=false

# Separate browser origins; the private admin origin must not share the public host.
PUBLIC_APP_ORIGIN=https://app.example.com
ADMIN_APP_ORIGIN=https://admin.example.com
ADMIN_EMAILS=owner@example.com
ADMIN_SESSION_HOURS=12

# Required for production Google-only operator sign-in.
SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Add https://admin.example.com/auth/callback/google as the Google OAuth redirect URI.

# Required trust boundary between Cloudflare Pages Functions and FastAPI.
# Put the same ORIGIN_PROXY_SECRET in both Pages projects as a server-side secret.
ORIGIN_PROXY_SECRET=

# Redis is required for rate limits, sessions, scheduler coordination, and Telegram commands.
REDIS_URL=redis://redis:6379/0
# Existing SQLite data remains in ./database/signals.db inside the container.
SIGNAL_ENGINE_DB_PATH=database/signals.db

# Cloudflare Tunnel token used by the included cloudflared Compose service.
TUNNEL_TOKEN=
TUNNEL_PROTOCOL=http2
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.2

# Demo credentials are required for paper execution and account-switch checks.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET=
BINANCE_DEMO_BASE_URL=https://demo-fapi.binance.com
# Optional live account. Leave empty until you intend to enable real execution.
BINANCE_API_KEY=
BINANCE_SECRET=
# Exact value required to permit live activation: I_UNDERSTAND_REAL_ORDERS
SIGNAL_ENGINE_ALLOW_LIVE_TRADING=
# Compose sets MODE_SWITCH_RESTART=true automatically. Leave false outside a process supervisor.
MODE_SWITCH_RESTART=false

# Telegram commands use outbound polling by default (no inbound webhook needed).
TELEGRAM_TRANSPORT=polling
# Optional webhook mode: set TELEGRAM_TRANSPORT=webhook.
# The webhook URL is ADMIN_APP_ORIGIN/webhook/telegram.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Numeric Telegram sender ID(s), comma-separated. Always set for group chats.
TELEGRAM_ALLOWED_USER_IDS=
# Generate separately from the session/proxy secrets; Telegram accepts 1–256 chars from [A-Za-z0-9_-].
WEBHOOK_SECRET=

# Required for closing positions and for both directions of the paper/live switch.
TOTP_SECRET=

# Optional research/data providers.
FINNHUB_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_TELEGRAM_ASSISTANT=false

# Optional Angel One integration. Set the full credential set only if needed.
ANGELONE_CLIENT_ID=
ANGELONE_API_KEY=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Optional content publishing integration. Disabled unless explicitly enabled.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
CONTENT_ENABLED=false
CONTENT_AUTO_APPROVE=false

# Optional external trace metadata.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=signal-engine

# Research defaults; these do not certify strategy performance.
CAPITAL=1000
SYSTEM_VERSION=2.0.0
ADAPTATION_FROZEN=false
