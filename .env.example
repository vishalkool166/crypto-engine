# Copy to .env on the AWS host. Generate each secret independently with: openssl rand -hex 48
ENV=production
PORT=8000
TRADING_MODE=paper
ENGINE_ENABLED=true

# Canonical browser origins. Register Google OAuth callback at the admin origin below.
PUBLIC_APP_ORIGIN=https://app.vishalkool.top
ADMIN_APP_ORIGIN=https://admin-app.vishalkool.top
ADMIN_EMAILS=vishalkool166@gmail.com
ADMIN_SESSION_HOURS=12
SESSION_SECRET=
ORIGIN_PROXY_SECRET=

# Google OAuth web client. Authorized redirect URI:
# https://admin-app.vishalkool.top/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend and durable storage. Compose overrides REDIS_URL to the Redis service.
REDIS_URL=redis://redis:6379/0
SIGNAL_ENGINE_DB_PATH=database/signals.db

# Cloudflare Tunnel token for the cloudflared container.
TUNNEL_TOKEN=

# Binance demo/testnet credentials only. No live trading is enabled by this release.
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_SECRET=
BINANCE_DEMO_BASE_URL=https://testnet.binancefuture.com

# Telegram operator bot. Create WEBHOOK_SECRET as a random URL-safe token;
# the bot registers /webhook/telegram through ADMIN_APP_ORIGIN.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
WEBHOOK_SECRET=

# Optional operator-only integrations.
TOTP_SECRET=
FINNHUB_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
ENABLE_TELEGRAM_ASSISTANT=false

# Optional Angel One connection. Configure the complete set only if used.
ANGELONE_CLIENT_ID=
ANGELONE_API_KEY=
ANGELONE_PASSWORD=
ANGELONE_TOTP_SECRET=

# Optional content integration. Leave disabled unless configured.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
CONTENT_ENABLED=false
CONTENT_AUTO_APPROVE=false

# Optional trace metadata.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=signal-engine

# Research defaults. Kept non-secret and paper-only.
CAPITAL=1000
SYSTEM_VERSION=1.0.0
ADAPTATION_FROZEN=false
